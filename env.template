# =============================================================================
# MockFlow-AI environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate one with: cp env.template .env
#
# These are the variables the Flask web app actually reads. LiveKit / OpenAI /
# Deepgram keys are NOT here: this is a BYOK app — each user supplies their own
# in the in-app Settings (API Keys) page, and they are stored Fernet-encrypted
# in the database. The agent worker receives them per-interview from the user's
# stored keys, not from this file.
# =============================================================================


# =============================================================================
# REQUIRED — the app will not start in production without these
# =============================================================================

# Postgres connection string (Neon — free, always-on, scale-to-zero).
# Neon dashboard -> Connect -> "Pooled connection".
# postgresql://user:pass@ep-xxxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Google OAuth (Authlib + Flask-Login). Add this redirect URI to the OAuth
# client: https://<your-domain>/auth/google/callback  (and the localhost one
# for dev: http://localhost:5000/auth/google/callback)
GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Flask session signing key (required for login cookies).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_hex_chars

# Fernet key encrypting users' stored BYOK API keys. Keep this stable — losing
# it makes every stored key unrecoverable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_fernet_key


# =============================================================================
# OPTIONAL — sensible defaults exist; override only if needed
# =============================================================================

# "production" enables Secure cookies + fails fast on missing required vars.
# Leave unset (or "development") for local http dev.
FLASK_ENV=development

# Comma-separated allowed CORS origins for /api/* (defaults to localhost).
# In production set this to your deployed origin.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Max concurrent interview agent subprocesses (default: 10).
MAX_CONCURRENT_WORKERS=10


# =============================================================================
# FREE TIER (optional) — give new users N interviews on YOUR keys
# =============================================================================
# Off by default. When FREE_TIER_ENABLED=true AND all five SYSTEM_* keys are
# set, a user with no BYOK keys can run up to `free_calls_granted` interviews
# (default 2, per verified email) funded by these owner keys. A global monthly
# ceiling acts as a cost kill-switch.
FREE_TIER_ENABLED=false
FREE_TIER_MONTHLY_MAX_CALLS=500

# Owner-funded keys used for free-tier interviews (leave blank to disable).
SYSTEM_LIVEKIT_URL=
SYSTEM_LIVEKIT_API_KEY=
SYSTEM_LIVEKIT_API_SECRET=
SYSTEM_OPENAI_KEY=
SYSTEM_DEEPGRAM_KEY=
