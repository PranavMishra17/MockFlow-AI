# =============================================================================
# MockFlow-AI environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate one with: cp env.template .env
#
# These are the variables the Flask web app actually reads. LiveKit / OpenAI /
# Deepgram keys are NOT here: this is a BYOK app — each user supplies their own
# in the in-app Settings (API Keys) page, and they are stored Fernet-encrypted
# in the database. The agent worker receives them per-interview from the user's
# stored keys, not from this file.
# =============================================================================


# =============================================================================
# REQUIRED — the app will not start in production without these
# =============================================================================

# Postgres connection string (Neon — free, always-on, scale-to-zero).
# Neon dashboard -> Connect -> "Pooled connection".
# postgresql://user:pass@ep-xxxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Google OAuth (Authlib + Flask-Login). Add this redirect URI to the OAuth
# client: https://<your-domain>/auth/google/callback  (and the localhost one
# for dev: http://localhost:5000/auth/google/callback)
GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Flask session signing key (required for login cookies).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_hex_chars

# Fernet key encrypting users' stored BYOK API keys. Keep this stable — losing
# it makes every stored key unrecoverable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_fernet_key


# =============================================================================
# OPTIONAL — sensible defaults exist; override only if needed
# =============================================================================

# "production" enables Secure cookies + fails fast on missing required vars.
# Leave unset (or "development") for local http dev.
FLASK_ENV=development

# Comma-separated allowed CORS origins for /api/* (defaults to localhost).
# In production set this to your deployed origin.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Max concurrent interviews (default: 10). Counts both locally spawned
# subprocesses and interviews handed to a resident worker via dispatch.
MAX_CONCURRENT_WORKERS=10


# =============================================================================
# AGENT TRANSPORT (optional) — how the interviewer gets into the room
# =============================================================================
# direct   (default) The web process spawns agent_worker.py per interview and
#          that subprocess connects straight to the room. Self-contained, but
#          every interview's memory lands on the web box.
#
# dispatch A separate RESIDENT worker registers with a LiveKit project and the
#          server hands it rooms as jobs. Run it with:
#              AGENT_MODE=dispatch python agent_worker.py start
#
# The resident worker runs on the SYSTEM_* keys below — the same set the web
# process compares an interview against, so "these keys match the worker" is a
# claim that can actually be true. Nothing else needs to be set for it.
#
# IMPORTANT — dispatch only covers system-key (free-tier) interviews. This app is
# BYOK, and a worker registered against YOUR LiveKit project can never receive a
# job for a room in a *user's* project; it would also bill that interview to your
# OpenAI/Deepgram accounts. All five credentials must match or the interview
# falls back to a direct spawn, so the web box must still be able to spawn.
# See docs/AGENT_DISPATCH.md.
AGENT_MODE=direct

# agent_name the dispatch worker registers under; must match on both sides.
# Only needed if two deploys share one LiveKit project.
# AGENT_NAME=mockflow-interviewer


# =============================================================================
# FREE TIER (optional) — give new users N interviews on YOUR keys
# =============================================================================
# Off by default. When FREE_TIER_ENABLED=true AND all five SYSTEM_* keys are
# set, a user with no BYOK keys can run up to `free_calls_granted` interviews
# (default 2, per verified email) funded by these owner keys. A global monthly
# ceiling acts as a cost kill-switch.
FREE_TIER_ENABLED=false
FREE_TIER_MONTHLY_MAX_CALLS=500

# Owner-funded keys used for free-tier interviews (leave blank to disable).
SYSTEM_LIVEKIT_URL=
SYSTEM_LIVEKIT_API_KEY=
SYSTEM_LIVEKIT_API_SECRET=
SYSTEM_OPENAI_KEY=
SYSTEM_DEEPGRAM_KEY=


# =============================================================================
# CODING-TRACK EXECUTION (optional) — ground coding feedback in real test runs
# =============================================================================
# When enabled, submitted code in the coding track is executed against the
# vetted problem's hidden test cases on a Piston instance, and the objective
# pass/fail is fed into the evaluator. Off by default (LLM-only when off).
# Use the public instance to start; self-host Piston to drop the rate limit.
PISTON_ENABLED=false
PISTON_URL=https://emkc.org/api/v2/piston
PISTON_PYTHON_VERSION=3.10.0
