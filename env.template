# =============================================================================
# LIVEKIT CONFIGURATION (Required)
# =============================================================================
# Get from: https://cloud.livekit.io/
# Steps: Create account → Create project → Settings → Keys

LIVEKIT_URL=wss://your-project-name.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
# AI PROVIDERS (Required)
# =============================================================================

# OpenAI (for LLM and TTS)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Deepgram (for Speech-to-Text)
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
# FLASK CONFIGURATION (Optional)
# =============================================================================

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=true

# Flask Port (default: 5000)
FLASK_PORT=5000


# =============================================================================
# INTERVIEW STAGE SETTINGS (Optional - has defaults)
# =============================================================================

# Stage 1: Self-Introduction max duration (seconds)
STAGE_INTRO_DURATION=240

# Stage 2: Past Experience max duration (seconds)
STAGE_EXPERIENCE_DURATION=360

# Inactivity timeout before prompting (seconds)
INACTIVITY_TIMEOUT=15


# =============================================================================
# LOGGING (Optional)
# =============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable file logging
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log


# =============================================================================
# XATA + AUTHLIB (Required after migration from Supabase)
# =============================================================================
# Xata Postgres connection string. Get from Xata dashboard:
# Settings -> Connect with Postgres -> copy "Connection string"
# Format: postgresql://<workspace>:<api_key>@<region>.sql.xata.sh/<db>:main?sslmode=require
XATA_DATABASE_URL=postgresql://workspace:apikey@us-east-1.sql.xata.sh/mockflow-ai:main?sslmode=require

# Google OAuth credentials (reused from existing Google Cloud OAuth client).
# Add redirect URI to that client: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Flask session signing key (required for Flask-Login cookies).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_64_hex_chars

# Fernet encryption key for BYOK API key storage (same as before migration).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_fernet_key


# =============================================================================
# NOTES
# =============================================================================
# 1. Only the first 4 variables are REQUIRED to run the app
# 2. Never commit this file with real credentials
# 3. Copy to .env and fill in your actual values
# 4. Keep .env in .gitignore
